+        // PSRP: with every menu closed, the draw and button ticks have nothing to do, but the runtime
+        // still starts each of them every frame. ProcessMenus takes them off the tick list when it
+        // finds every menu closed, and Menu.Visible puts them back when a menu opens, so they run
+        // again from the next frame, as they would have anyway.
+        private static MenuController instance;
+        private static bool menuTicksAsleep;
+
+        private void SleepMenuTicks()
+        {
+            if (menuTicksAsleep)
+            {
+                return;
+            }
+            menuTicksAsleep = true;
+            Tick -= ProcessMenus;
+#if FIVEM
+            Tick -= DrawInstructionalButtons;
+#endif
+            Tick -= ProcessMainButtons;
+            Tick -= ProcessDirectionalButtons;
+        }
+
+        internal static void WakeMenuTicks()
+        {
+            if (!menuTicksAsleep || instance == null)
+            {
+                return;
+            }
+            menuTicksAsleep = false;
+            instance.Tick += ProcessMenus;
+#if FIVEM
+            instance.Tick += DrawInstructionalButtons;
+#endif
+            instance.Tick += instance.ProcessMainButtons;
+            instance.Tick += instance.ProcessDirectionalButtons;
+        }
